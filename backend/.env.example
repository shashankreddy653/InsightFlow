# InsightFlow backend configuration
# Copy to .env and fill in values. Never commit real secrets.

# SQLite database file (relative to backend/)
INSIGHTFLOW_DATABASE_URL=sqlite:///./data/insightflow.db

# Max CSV upload size in megabytes
INSIGHTFLOW_MAX_UPLOAD_MB=25

# Analysis
INSIGHTFLOW_ANALYSIS_BATCH_SIZE=200

# Optional LLM for richer recommendation text (OpenAI-compatible).
# If unset, recommendations are generated by the transparent local
# template engine and labelled as such in the UI.
INSIGHTFLOW_LLM_API_KEY=
INSIGHTFLOW_LLM_BASE_URL=https://api.openai.com/v1
INSIGHTFLOW_LLM_MODEL=gpt-4o-mini

# Adaption (https://adaptionlabs.ai) API key.
# Create at: https://adaptionlabs.ai/app/settings?tab=api_keys
# If unset, the app runs its local analysis pipeline and the
# Integrations page shows honest "not configured" status.
ADAPTION_API_KEY=

# CORS: comma-separated origins allowed by the API
INSIGHTFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
